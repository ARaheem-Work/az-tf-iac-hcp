# Terraform local working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan
*tfplan*

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files that often contain secrets
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.tfvars.example

# Local environment files
.env
.env.*

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
